rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if a document is owned by the current user
    function isOwner(data) {
      return request.auth != null && data.userId == request.auth.uid;
    }

    // Helper to check if the user is the master administrator
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'isabelemfa@gmail.com';
    }

    match /stores/{storeId} {
      allow read: if request.auth != null && (isAdmin() || resource == null || resource.data.userId == request.auth.uid || !('userId' in resource.data));
      allow write: if request.auth != null && (isAdmin() || request.resource.data.userId == request.auth.uid || !('userId' in request.resource.data));
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && (isAdmin() || resource == null || resource.data.userId == request.auth.uid || !('userId' in resource.data));
      allow write: if request.auth != null && (isAdmin() || request.resource.data.userId == request.auth.uid || !('userId' in request.resource.data));
    }
    
    match /user_profiles/{uid} {
      allow read: if request.auth != null;
    }
    
    // For the migration path mentioned in the error handler
    match /migrate_local_data/{userId} {
      allow read, write: if request.auth != null && userId == request.auth.uid;
    }
    
    // Fallback for collection group queries or other collections if necessary
    // But we only have stores and notifications for now
  }
}
